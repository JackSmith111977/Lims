{
  "name": "lims-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration/sample-task-main-flow.mjs",
    "test:method-integration": "node scripts/integration/method-versioning.mjs",
