    "test:processing-integration": "node scripts/integration/experiment-processing.mjs",
    "test:review-integration": "node scripts/integration/result-review.mjs",
    "test:report-integration": "node scripts/integration/reporting.mjs",
    "test:instrument-integration": "node scripts/integration/instrument-registry.mjs",
    "test:inventory-integration": "node scripts/integration/inventory-management.mjs",
    "test:e2e": "playwright test --pass-with-no-tests",
    "supabase:status": "supabase status",
    "supabase:migrations": "supabase migration list",
    "supabase:dry-run": "supabase db push --dry-run",
    "supabase:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --linked",
